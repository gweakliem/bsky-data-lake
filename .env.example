# Copy to .env and fill in. Real environment variables take precedence.

# S3 bucket to write to (used when no output path is given on the command line)
BSKY_BUCKET=my-bucket
# Bucket holding the Iceberg tables (Glue database locations)
BSKY_WAREHOUSE_BUCKET=my-warehouse-bucket
# Key prefix within the bucket (default: jetstream)
# BSKY_PREFIX=jetstream
AWS_REGION=us-west-2

# Optional overrides
# BSKY_BATCH_SIZE=10000
# BSKY_FLUSH_INTERVAL=60

# --- iceberg-loader ---
# SQS queue receiving S3 notifications (`pulumi stack output queue_url` in infra/)
BSKY_LOADER_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456789012/bsky-raw-files
# Iceberg table and its location (defaults shown)
# BSKY_ICEBERG_TABLE=glue.bsky_raw.jetstream
# BSKY_ICEBERG_LOCATION=s3://my-warehouse-bucket/iceberg/bsky_raw/jetstream
# Spark Connect URL of a Sail server; if unset the loader starts an embedded one
# SPARK_REMOTE=sc://localhost:50051
