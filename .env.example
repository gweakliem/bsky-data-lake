# Copy to .env and fill in. Real environment variables take precedence.

# S3 bucket to write to (used when no output path is given on the command line)
BSKY_BUCKET=my-bucket
# Key prefix within the bucket (default: jetstream)
# BSKY_PREFIX=jetstream
AWS_REGION=us-west-2

# Optional overrides
# BSKY_BATCH_SIZE=10000
# BSKY_FLUSH_INTERVAL=60
