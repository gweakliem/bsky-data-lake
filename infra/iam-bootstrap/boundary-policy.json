{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EverythingExceptIdentityAdmin",
      "Effect": "Allow",
      "NotAction": ["iam:*", "organizations:*", "account:*", "sso:*", "identitystore:*"],
      "Resource": "*"
    },
    {
      "Sid": "IamNeededByEksRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRoles",
        "iam:ListInstanceProfiles",
        "iam:GetInstanceProfile",
        "iam:CreateServiceLinkedRole",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyProjectRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/bsky/*"
    }
  ]
}
